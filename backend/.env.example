NODE_ENV=development
PORT=5000

# MongoDB
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/preyeah?retryWrites=true&w=majority

# JWT
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRE=15m
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string
JWT_REFRESH_EXPIRE=7d

# CORS — frontend origin(s), comma-separated. Also used to build email links.
CLIENT_URL=http://localhost:5173

# Google OAuth 2.0 (Authorization Code flow — students only)
# Create a Web application credential in Google Cloud Console.
# Add http://localhost:5000/api/auth/google/callback as an authorised redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# AI (Groq) — required for chat, roadmaps, quizzes, profile extraction
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=openai/gpt-oss-120b

# Email (optional in development: links are printed to the console when SMTP_HOST is empty)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Use a sender address verified with your SMTP provider (required in production).
SMTP_FROM=

# scripts/createAdmin.js
# ADMIN_NAME=Admin
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=change_me_now
