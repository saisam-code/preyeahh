NODE_ENV=development
PORT=5000

# MongoDB
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/preyeah?retryWrites=true&w=majority

# JWT
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRE=15m
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string
JWT_REFRESH_EXPIRE=7d

# CORS — frontend origin(s), comma-separated. Also used to build email links.
CLIENT_URL=http://localhost:5173

# AI (Groq) — required for chat, roadmaps, quizzes, profile extraction
GROQ_API_KEY=your_groq_api_key
# GROQ_MODEL=llama-3.3-70b-versatile

# Email (optional in development: links are printed to the console when SMTP_HOST is empty)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Pre-Yeah" <no-reply@preyeah.dev>

# scripts/createAdmin.js
# ADMIN_NAME=Admin
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=change_me_now
